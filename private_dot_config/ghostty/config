## common
scrollback-limit = 100000
term = "xterm-ghostty"

## font
font-thicken = true
font-size = 16
font-family = "MesloLGS Nerd Font"
font-style = "Regular"
grapheme-width-method = "unicode"
background-opacity = 0.5

## theme
theme = Flexoki Dark
adjust-cell-width = -5%
background-opacity = 0.85
background-blur-radius = 20
window-decoration = false
window-padding-x = 18
window-padding-y = 2,10
window-theme = dark
window-width = 10000
window-height = 10000
window-padding-balance = true

## shell
shell-integration = zsh
window-decoration = auto
# command=/bin/zsh -l -c zellij attach -c ghostty
quit-after-last-window-closed = true
# confirm-close-surface = false

## cursor
cursor-style = "bar"
cursor-style-blink = true
mouse-hide-while-typing = true

## Zellij-style Ctrl-X shortcuts
keybind = ctrl+x>c=new_tab
keybind = ctrl+x>n=next_tab
keybind = ctrl+x>p=previous_tab
keybind = ctrl+x>1=goto_tab:1
keybind = ctrl+x>2=goto_tab:2
keybind = ctrl+x>3=goto_tab:3
keybind = ctrl+x>4=goto_tab:4
keybind = ctrl+x>5=goto_tab:5
keybind = ctrl+x>6=goto_tab:6
keybind = ctrl+x>7=goto_tab:7
keybind = ctrl+x>8=goto_tab:8
keybind = ctrl+x>9=goto_tab:9
keybind = ctrl+x>shift+5=new_split:right
keybind = ctrl+x>shift+apostrophe=new_split:down
keybind = ctrl+x>h=goto_split:left
keybind = ctrl+x>j=goto_split:down
keybind = ctrl+x>k=goto_split:up
keybind = ctrl+x>l=goto_split:right
keybind = ctrl+x>o=goto_split:next
keybind = ctrl+x>left=goto_split:left
keybind = ctrl+x>down=goto_split:down
keybind = ctrl+x>up=goto_split:up
keybind = ctrl+x>right=goto_split:right
keybind = ctrl+x>z=toggle_split_zoom
keybind = ctrl+x>x=close_surface
keybind = ctrl+x>comma=prompt_tab_title
keybind = ctrl+x>ctrl+b=text:\x02
keybind = ctrl+x>ctrl+x=text:\x18
