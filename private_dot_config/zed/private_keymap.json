[
  {
    "context": "Editor",
    "bindings": {
      "cmd-shift-g": [
        "task::Spawn",
        { "task_name": "LazyGit", "reveal_target": "center" },
      ],
      "ctrl-f12": "editor::GoToImplementation",
      "ctrl-f11": "editor::GoToImplementationSplit",
      "shift-f12": "editor::GoToDeclaration",
      "ctrl-r": "outline::Toggle",
      "ctrl-pageup": "pane::ActivatePreviousItem",
      "ctrl-pagedown": "pane::ActivateNextItem",
      "cmd-pageup": "pane::ActivatePreviousItem",
      "cmd-pagedown": "pane::ActivateNextItem",
      "cmd-y": "editor::Redo",
      "ctrl-left": "editor::MoveToPreviousWordStart",
      "ctrl-right": "editor::MoveToNextWordEnd",
      "ctrl-shift-left": "editor::SelectToPreviousWordStart",
      "ctrl-shift-right": "editor::SelectToNextWordEnd",
    },
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "ctrl-.": "project_panel::NewFile",
      "ctrl-,": "project_panel::NewDirectory",
      "f2": "project_panel::Rename",
      "enter": "project_panel::Open",
    },
  },
  // {
  //   "bindings": {
  //     "cmd-p": [
  //       "task::Spawn",
  //       { "task_name": "Television File Finder", "reveal_target": "center" }
  //     ]
  //   }
  // }
  {
    "context": "AcpThread > (Editor && use_modifier_to_send)",
    "bindings": {
      "cmd-shift-d": "agent::RejectAll",
    },
  },
  {
    "context": "AcpThread > (Editor && !use_modifier_to_send)",
    "bindings": {
      "cmd-shift-d": "agent::RejectAll",
    },
  },
  {
    "context": "(MessageEditor && !Picker) > (Editor && use_modifier_to_send)",
    "bindings": {
      "cmd-shift-d": "agent::RejectAll",
    },
  },
  {
    "context": "(MessageEditor && !Picker) > (Editor && !use_modifier_to_send)",
    "bindings": {
      "cmd-shift-d": "agent::RejectAll",
    },
  },
  {
    "context": "(Editor && editor_agent_diff)",
    "bindings": {
      "cmd-shift-d": "agent::RejectAll",
    },
  },
  {
    "context": "AgentDiff",
    "bindings": {
      "cmd-shift-d": "agent::RejectAll",
    },
  },
  {
    "context": "Pane",
    "bindings": {
      "cmd-shift-f": "workspace::NewSearch",
    },
  },
]
